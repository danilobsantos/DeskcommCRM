# ==============================================================================
# 1) DOMÍNIO E URLS (Substitua crm.devstudiosyste.com.br pelo seu domínio se mudar)
# ==============================================================================
DOMAIN=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_ADMIN_URL=
PORT=3000
NODE_ENV=production

# ==============================================================================
# 2) TRAEFIK / DOKPLOY
# ==============================================================================
TRAEFIK_NETWORK=dokploy-network
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# ==============================================================================
# 3) CONEXÃO COM O SUPABASE (Sincronizado com .env-supabase)
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# URL interna para chamadas server-side (elimina latência Brasil→Europa)
# Usar http://kong:8000 quando Deskcomm e Supabase estão na mesma rede Docker
SUPABASE_INTERNAL_URL=http://kong:8000

# Conexão com o banco Postgres do Supabase:
SUPABASE_DB_URL=
DATABASE_URL=

# ==============================================================================
# 4) INTELIGÊNCIA ARTIFICIAL
# ==============================================================================
ANTHROPIC_API_KEY=sk-ant-api03-sua-chave-aqui

# ==============================================================================
# 5) REDIS INTERNO (Comunicação entre os containers)
# ==============================================================================
UPSTASH_REDIS_REST_URL=http://srh:80
UPSTASH_REDIS_REST_TOKEN=srh_token_secret_1234567890abcdef
SRH_TOKEN=srh_token_secret_1234567890abcdef

# ==============================================================================
# 6) WHATSAPP (WAHA) INTERNO
# ==============================================================================
WAHA_API_BASE_URL=http://waha:3000
WAHA_WEBHOOK_BASE_URL=http://app:3000
WAHA_API_KEY=waha_secret_token_123456
WAHA_API_KEY_SHA512=
WAHA_HMAC_SECRET=waha_hmac_secret_token_654321
WHATSAPP_RESTART_ALL_SESSIONS=True

# ==============================================================================
# 6b) MARCA (white-label) — SEMENTE. O banco manda. Ver lib/branding.ts.
# ==============================================================================
APP_NAME=
APP_LOGO_URL=
APP_LOGO_URL_DARK=
APP_ACCENT_HEX=

# ==============================================================================
# 7) SEGREDOS DE CRIPTOGRAFIA E SEGURANÇA
# ==============================================================================
INTERNAL_SECRET=
INTERNAL_CRON_SECRET=
IMPERSONATE_COOKIE_SECRET=
LGPD_SIGNING_KEY=

# Chaves em Base64 (32 bytes):
CPF_ENCRYPTION_KEY=
AI_CRED_AES_KEY=
WAHA_BYO_ENCRYPTION_KEY=
